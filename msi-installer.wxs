<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*" Name="Saesth" Version="1.2.0"
             Manufacturer="Toi" Language="1033"
             UpgradeCode="be2c1fd9-c47c-44c8-9c23-ee7f459c17e6">

        <Package InstallerVersion="200"
                 Compressed="yes"
                 Platform="x64"
                 InstallScope="perMachine" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of Saesth is already installed." />
        <MediaTemplate EmbedCab="yes"/>

        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLDIR" Name="Saesth">
                    <Directory Id="DistDir" Name="dist">
                        <Component Id="DistDirCleanup" Guid="4FDBC8E4-BD29-408C-9A8E-9CD6AFF9A18A">
                            <RemoveFolder Id="RemoveDistDir" On="uninstall" />
                            <RegistryValue Root="HKLM" Key="Software\Saesth\Dist" Name="Path" Type="integer" Value="1" KeyPath="yes" />
                        </Component>
                    </Directory>
                    <Directory Id="SoundsDir" Name="sounds">
                        <Component Id="SoundsDirCleanup" Guid="4FDBC8E4-BD29-408C-9A8E-9CD6AFF9A18B">
                            <RemoveFolder Id="RemoveSoundsDir" On="uninstall" />
                            <RegistryValue Root="HKLM" Key="Software\Saesth\Sounds" Name="Path" Type="integer" Value="1" KeyPath="yes" />
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <Directory Id="DesktopFolder" Name="Desktop" />
            <Directory Id="ProgramMenuFolder" Name="Programs" />
        </Directory>

        <DirectoryRef Id="INSTALLDIR">
            <Component Id="SaesthComponent" Guid="8af092ce-98ea-49cc-93ca-aaf6d23113ad">
                <File Id="SaesthExe" Source="src-tauri\target\release\saesth.exe" KeyPath="yes" />

                <Shortcut Id="DesktopShortcut"
                          Directory="DesktopFolder"
                          Name="Saesth"
                          WorkingDirectory="INSTALLDIR"
                          Target="[INSTALLDIR]saesth.exe"
                          Advertise="no" />

                <Shortcut Id="StartMenuShortcut"
                          Directory="ProgramMenuFolder"
                          Name="Saesth"
                          WorkingDirectory="INSTALLDIR"
                          Target="[INSTALLDIR]saesth.exe"
                          Advertise="no" />

                <RemoveFolder Id="RemoveDesktop" Directory="DesktopFolder" On="uninstall" />
                <RemoveFolder Id="RemoveStartMenu" Directory="ProgramMenuFolder" On="uninstall" />
                <RemoveFolder Id="RemoveInstallDir" On="uninstall" />
            </Component>
            
            <Component Id="AssetsComponent" Guid="4FDBC8E4-BD29-408C-9A8E-9CD6AFF9A188">
                <File Id="SaesthPng" Source="assets\saesth.png" KeyPath="yes" />
                <File Id="ScreenPng" Source="assets\screen.png" />
            </Component>
        </DirectoryRef>

        <Feature Id="MainFeature" Level="1">
            <ComponentRef Id="SaesthComponent"/>
            <ComponentRef Id="AssetsComponent"/>
            <ComponentRef Id="DistDirCleanup"/>
            <ComponentRef Id="SoundsDirCleanup"/>
            <ComponentGroupRef Id="DistFilesGroup" />
            <ComponentGroupRef Id="SoundsFilesGroup" />
        </Feature>

    </Product>
</Wix>