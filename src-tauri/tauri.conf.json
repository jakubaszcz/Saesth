{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "saesth",
  "version": "0.1.0",
  "identifier": "com.bangl.saesth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "plugins": {
    "dev-server": {
      "host": "localhost",
      "port": 1420
    }
  },
  "app": {
    "windows": [
      {
        "title": "saesth",
        "width": 800,
        "height": 600,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**/*",
          "$HOME/AppData/Roaming/saesth/saesth/data/packs/**/*",
          "$HOME/AppData/Local/saesth/saesth/cache/packs/**/*"
        ]
      },
      "csp": "default-src 'self'; img-src 'self' asset.localhost http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "resources": [
      "sounds/rain/**/*",
      "sounds/beach/**/*",
      "sounds/waterfall/**/*",
      "sounds/fire/**/*",
      "sounds/effects/**/*"
    ]
  }
}
